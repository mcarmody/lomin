# LÓMIN environment. Copy to /etc/lomin.env (systemd EnvironmentFile) or export before running.
# Each line is optional. A commented line keeps the default shown after the =.
# Secrets are left blank: fill them in on the host, never commit a filled copy.

# ~/.mvg — state root: watch tokens, piper config and binaries, voice capture, speakers, the desktop TTS voice clip
# MVG_HOME=

# unset — module name of the plugin (see "Plugin")
# MVG_PLUGIN=

# plugin when the plugin has brain_call, else http — plugin or http
# MVG_BRAIN=

# unset (required for http) — endpoint the http brain POSTs to
# MVG_BRAIN_URL=

# unset — if set, sent as Authorization: Bearer <token>
# MVG_BRAIN_TOKEN=

# agent — brain target for a node with no profile (MVG_HIVE_TARGET is read as a fallback)
# MVG_DEFAULT_TARGET=agent

# 45 — seconds a brain call may take
# MVG_HIVE_TIMEOUT=45

# the assistant — the agent's name in prompts and the spoken apology
# MVG_AGENT_NAME="the assistant"

# unset — comma list of every spelling the agent's name can come out of Whisper as; empty means the name pre-gate never matches
# MVG_AGENT_NAMES=

# same as MVG_AGENT_NAMES — names that count after a greeting ("hey <name>") to open an utterance
# MVG_WAKE_NAMES=

# 9098
# MVG_PORT=9098

# 0.0.0.0
# MVG_BIND=0.0.0.0

# http://127.0.0.1:9099/transcribe
# WHISPER_URL=http://127.0.0.1:9099/transcribe

# $MVG_HOME/piper-tts.json
# MVG_PIPER_CONFIG=

# <gateway dir>/logs
# MVG_LOG_DIR=

# http://127.0.0.1:9097/tts
# MVG_DESKTOP_TTS_URL=http://127.0.0.1:9097/tts

# 8 (seconds)
# MVG_DESKTOP_TTS_TIMEOUT=8

# 1 — /ask/stream sends sub-sentence pcm sentence events (format=pcm, 24 kHz mono, text on the first chunk of each sentence only) read from the desktop POST /tts/stream; 0 = whole-sentence WAV events. Logs first_audio_ms/tts_first_ms
# MVG_TTS_STREAM=1

# derived: MVG_DESKTOP_TTS_URL + /stream
# MVG_DESKTOP_TTS_STREAM_URL=

# 4800 (~100 ms, the hub's own forwarding floor)
# MVG_TTS_STREAM_MIN_CHUNK_BYTES=4800

# 1 — filler clips while the brain is silent, pcm stream mode only (see "Gap-fill and latency metrics"); 0 disables
# MVG_GAP_FILL=1

# <gateway dir>/gap-fill
# MVG_GAP_FILL_DIR=

# 1200 — no real audio by this long after request start: emit one acknowledge/thinking clip
# MVG_GAP_FILL_AFTER_MS=1200

# 5000 — silence (audio already sent has finished playing) longer than this while the brain still works: emit one long_wait clip, at most one per turn
# MVG_GAP_FILL_LONG_MS=5000

# 0 — 1 makes /ask/stream send text-only sentence events (no audio_b64) and makes /v1/audio/speech stream (44-byte WAV header with unknown sizes, then 24 kHz mono PCM as synthesized; "stream": false in the request keeps the complete-WAV reply). For a hub's native streaming TTS client. Gap-fill is disabled in this mode: the hub latches a turn to brain-audio or remote-tts and rejects a mix, and a clip is audio
# MVG_TEXT_SENTENCES=0

# 1 — cut the first utterance early (terminator with no trailing space yet, a comma/colon after >=20 chars and 4 words, or after 12 words) instead of waiting for the next partial; 0 disables. Both modes
# MVG_FIRST_CLAUSE_EARLY=1

# 30 — how recent an /stt must be for its id/timing to be attached to the next /ask/stream turn record
# MVG_STT_CORRELATE_SEC=30

# $MVG_HOME/nodes.json (per-node profiles; see nodes.example.json)
# MVG_NODES_FILE=

# $MVG_HOME/node-targets.json (fallback, read only if nodes.json is absent)
# MVG_NODE_TARGETS_FILE=

# unset (JSON object, env; wins over the files)
# MVG_NODE_TARGETS=

# unset (shared secret for the X-Voice-Claimed-Speaker header; unset = claim ignored)
# MVG_TRUSTED_KEY=

# 0.5 (voice ID grace after the transcript on /voice/turn)
# MVG_VOICE_ID_GRACE_SEC=0.5

# 0.6
# MVG_AMBIENT_THRESHOLD=0.6

# 0.5 (seconds)
# MVG_AMBIENT_LAYA_TIMEOUT=0.5

# 0.7 (Laya P(yes) that engages without Jev)
# MVG_AMBIENT_LAYA_CONFIDENT=0.7

# 2.5 (seconds)
# MVG_AMBIENT_JEV_TIMEOUT=2.5

# 12 (seconds)
# MVG_AMBIENT_HAIKU_TIMEOUT=12

# 6
# MVG_AMBIENT_CONTEXT_MAX_ENTRIES=6

# 180
# MVG_AMBIENT_CONTEXT_WINDOW_SEC=180

# 20
# MVG_AMBIENT_FOLLOWUP_WINDOW_SEC=20

# 0.5 (seconds, measured after STT finishes)
# MVG_AMBIENT_SPEAKER_WAIT_SEC=0.5

# 60
# MVG_STT_CACHE_TTL_SEC=60

# http://127.0.0.1:9096/embed
# MVG_DESKTOP_EMBED_URL=http://127.0.0.1:9096/embed

# 4 (seconds)
# MVG_DESKTOP_EMBED_TIMEOUT=4

# $MVG_HOME/speakers.json
# MVG_SPEAKERS_PATH=

# 0.70
# MVG_SPEAKER_THRESHOLD=0.70

# 1 — 0 turns speaker identification off on every node (identify false in resolve_profile)
# MVG_SPEAKER_ID=1

# unset (glob under /opt/lomin/venv/.../openwakeword/resources/models/silero_vad.onnx)
# MVG_SILERO_MODEL=

# 0.5 (Silero per-window probability)
# MVG_SPEECH_THRESHOLD=0.5

# 400 (voiced ms needed to pass the speech gate)
# MVG_MIN_SPEECH_MS=400

# 1 (0/false/off disables the gate)
# MVG_SPEECH_GATE=1

# desktop,piper — comma list of TTS backends, tried in order; see "Backends". Unknown names are dropped with a stderr line; empty means piper
# MVG_TTS_CHAIN=desktop,piper

# unset — ElevenLabs voice id (required for elevenlabs)
# MVG_ELEVENLABS_VOICE_ID=

# eleven_multilingual_v2
# MVG_ELEVENLABS_MODEL=eleven_multilingual_v2

# unset — key for the elevenlabs TTS backend (required for it)
# ELEVENLABS_API_KEY=

# unset — OpenAI-compatible speech endpoint for the openai backend, e.g. http://localhost:8880/v1/audio/speech (required for it)
# MVG_OPENAI_TTS_URL=

# kokoro
# MVG_OPENAI_TTS_MODEL=kokoro

# af_sky
# MVG_OPENAI_TTS_VOICE=af_sky

# unset — bearer token sent to the openai endpoint, only when set
# MVG_OPENAI_TTS_KEY=

# unset — generic http backend: POST {"text": ...}, the response body is the WAV (required for it)
# MVG_HTTP_TTS_URL=


# Who must confirm a spoken security request in text.
# MVG_OWNER_NAME=the owner
# Speaker ids whose verified turns (paired device or voice ID) work like text,
# except for security settings. Empty: no turn is trusted.
MVG_TRUSTED_SPEAKERS=
# Speaker text when voice ID cannot place the speaker.
# MVG_UNKNOWN_SPEAKER=unknown (answer for everyone present)

# Agent reply label in the addressee context, and its Piper voice_mapping key.
# MVG_AGENT_LABEL=agent
# classify_choice task key for the addressee question.
# MVG_CLASSIFY_KEY=lomin.ambient
# Request log file name under MVG_LOG_DIR.
# MVG_LOG_NAME=lomin.jsonl

# Plugin Talker backends for live voice: name=module:Class, comma separated.
# MVG_TALKER_BACKENDS=

# Live voice (/voice/live)
# MVG_TALKER_BACKEND=
# Directory of per-target persona markdown files (<MVG_PERSONA_DIR>/<target>/voice_talker.md or voice.md).
# MVG_PERSONA_DIR=
# Built-in Gemini Live Talker (MVG_TALKER_BACKEND=gemini); key is required.
# MVG_GEMINI_API_KEY=
# MVG_GEMINI_MODEL=gemini-3.8-live
# MVG_GEMINI_VOICE=
# MVG_GEMINI_INSTRUCTIONS=
# MVG_GEMINI_URL=
# Cascaded text-in/text-out Talker backend (MVG_TALKER_BACKEND=cascaded).
# MVG_TALKER_URL=
# MVG_TALKER_MODEL=gpt-4o-mini
# MVG_TALKER_KEY=
# MVG_TALKER_TIMEOUT=15
# MVG_TALKER_INSTRUCTIONS=
# MVG_LIVE_MAX_SEC=600
# MVG_LIVE_IDLE_SEC=30
# MVG_LIVE_MAX_FRAME=262144
# Spoken cancel on /voice/turn: "stop" / "cancel that" cancels the running turn.
# MVG_SPOKEN_CANCEL=0
# MVG_CANCEL_PHRASES=stop,cancel,cancel that,never mind,nevermind,stop that

# Spoken progress lines during long tasks (pcm stream mode).
# MVG_SPOKEN_PROGRESS=0
# MVG_PROGRESS_MIN_GAP_SEC=12
# MVG_PROGRESS_MAX_PER_TURN=3
# MVG_PROGRESS_STAGES=tool_start,milestone

# Context opener: first stage event becomes the opener line.
# MVG_CONTEXT_OPENER=0
